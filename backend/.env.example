# SentiNews Learn - Backend Environment Configuration Template
PROJECT_NAME="SentiNews Learn API"
ENVIRONMENT="development"

# Database Configuration (Neon PostgreSQL or local PostgreSQL)
# Example: postgresql+asyncpg://USER:PASSWORD@ep-xyz-123.aws.neon.tech/neondb?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sentinews_learn

# Security Secrets (Change in Production)
JWT_SECRET=your_32_byte_jwt_secret_key_change_in_production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
